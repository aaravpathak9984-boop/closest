<div style="max-width: 440px; margin: 2rem auto;">
  <div class="glass-card sketch-corner">
    <div style="margin-bottom: 1.5rem; text-align: center;">
      <span class="mono-label">Authentication</span>
      <h2 style="margin-top: 0.25rem;">Welcome Back</h2>
      <p style="font-size: 0.85rem; color: var(--color-soft-ink);">Log in to access your dashboard</p>
    </div>

    <% if (errors && errors.general) { %>
      <div class="alert alert-error">
        <span>⚠️ <%= errors.general %></span>
      </div>
    <% } %>

    <form action="/login" method="POST" id="loginForm">
      <div class="form-group">
        <label for="email" class="form-label">Email Address</label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          class="form-control <%= errors && errors.email ? 'is-invalid' : '' %>" 
          placeholder="name@example.com"
          value="<%= values && values.email ? values.email : '' %>"
          required
        >
        <% if (errors && errors.email) { %>
          <div class="invalid-feedback"><%= errors.email %></div>
        <% } %>
      </div>

      <div class="form-group">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
          <label for="password" class="form-label" style="margin-bottom: 0;">Password</label>
          <a href="/forgot-password" style="font-size: 0.78rem; color: var(--color-red-accent);">Forgot password?</a>
        </div>
        <div class="password-input-wrapper">
          <input 
            type="password" 
            id="password" 
            name="password" 
            class="form-control <%= errors && errors.password ? 'is-invalid' : '' %>" 
            placeholder="••••••••"
            required
          >
          <button type="button" class="password-toggle-btn" data-target="password" title="Show password" aria-label="Show password">👁️</button>
        </div>
        <% if (errors && errors.password) { %>
          <div class="invalid-feedback"><%= errors.password %></div>
        <% } %>

      </div>

      <button type="submit" class="btn btn-primary w-100 mt-2">Log In</button>
    </form>

    <hr class="paper-rule">

    <div class="text-center" style="font-size: 0.85rem; color: var(--color-soft-ink);">
      Don't have an account? <a href="/signup" style="font-weight: 600;">Sign up here</a>
    </div>
  </div>
</div>
