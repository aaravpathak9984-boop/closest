<div style="max-width: 440px; margin: 2rem auto;">
  <div class="glass-card sketch-corner">
    <div style="margin-bottom: 1.5rem; text-align: center;">
      <span class="mono-label">Account Recovery</span>
      <h2 style="margin-top: 0.25rem;">Forgot Password</h2>
      <p style="font-size: 0.85rem; color: var(--color-soft-ink);">Enter your email address to receive reset instructions</p>
    </div>

    <div class="alert alert-info">
      <span>ℹ️ Password reset via email is documented as a future extension point.</span>
    </div>

    <form action="/forgot-password" method="POST" onsubmit="event.preventDefault(); alert('Password reset emails are an extension point for exam day when real SMTP service is specified.');">
      <div class="form-group">
        <label for="email" class="form-label">Registered Email</label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          class="form-control" 
          placeholder="name@example.com"
          required
        >
      </div>

      <button type="submit" class="btn btn-secondary w-100 mt-1">Request Reset Link</button>
    </form>

    <hr class="paper-rule">

    <div class="text-center" style="font-size: 0.85rem; color: var(--color-soft-ink);">
      Remembered your password? <a href="/login" style="font-weight: 600;">Back to login</a>
    </div>
  </div>
</div>
