<div style="max-width: 1100px; margin: 1rem auto;">
  <!-- Header -->
  <div class="glass-card sketch-corner d-flex justify-between align-center mb-3" style="padding: 1.5rem 2rem;">
    <div>
      <span class="mono-label" style="color: var(--color-red-accent);">Healthcare Directory</span>
      <h2 style="margin: 0.15rem 0 0.25rem;">Browse Clinic Doctors</h2>
      <p style="font-size: 0.88rem; color: var(--color-soft-ink); margin: 0;">
        Select a specialized healthcare provider to pick your preferred appointment date and time slot.
      </p>
    </div>

    <!-- Filter & Search Controls -->
    <form action="/doctors" method="GET" style="display: flex; gap: 0.6rem; flex-wrap: wrap;">
      <input 
        type="text" 
        name="search" 
        class="form-control" 
        placeholder="Search doctor or specialty..." 
        value="<%= searchQuery %>"
        style="width: 220px; font-size: 0.85rem;"
      >
      <select name="specialization" class="form-control" onchange="this.form.submit()" style="width: 170px; font-size: 0.85rem;">
        <option value="">All Specializations</option>
        <% specializations.forEach(spec => { %>
          <option value="<%= spec %>" <%= selectedSpecialization === spec ? 'selected' : '' %>><%= spec %></option>
        <% }); %>
      </select>
      <button type="submit" class="btn btn-primary btn-sm">Filter</button>
      <% if (searchQuery || selectedSpecialization) { %>
        <a href="/doctors" class="btn btn-outline btn-sm">Clear</a>
      <% } %>
    </form>
  </div>

  <!-- Doctor Cards Grid -->
  <% if (doctors && doctors.length > 0) { %>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem;">
      <% doctors.forEach(doc => { %>
        <div class="paper-card d-flex flex-column justify-between" style="position: relative;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
              <div>
                <span class="badge badge-red mb-1"><%= doc.specialization %></span>
                <h3 style="margin: 0.2rem 0; font-size: 1.3rem;">
                  <a href="/doctors/<%= doc._id %>" style="color: inherit; text-decoration: none;"><%= doc.name %></a>
                </h3>
                <div style="display: flex; align-items: center; gap: 0.5rem; margin-top: 0.2rem;">
                  <span style="font-size: 0.8rem; color: var(--color-soft-ink); font-weight: 500;"><%= doc.qualification %></span>
                  <span style="color: #D9822B; font-weight: 700; font-size: 0.82rem;">⭐ <%= (doc.averageRating || 5.0).toFixed(1) %></span>
                </div>
              </div>
              <span class="mono-label" style="background: var(--bg-paper); padding: 0.3rem 0.6rem; border-radius: 4px; font-size: 0.72rem;">
                <%= doc.experienceYears %> yrs exp
              </span>
            </div>

            <p style="font-size: 0.85rem; color: var(--color-soft-ink); line-height: 1.5; margin-bottom: 1rem;">
              <%= doc.bio %>
            </p>
          </div>

          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 0.85rem; border-top: 1px dashed var(--color-border); margin-bottom: 1rem;">
              <div>
                <span class="mono-label" style="font-size: 0.68rem;">Consultation Fee</span>
                <div style="font-family: var(--font-serif); font-size: 1.15rem; font-weight: 700; color: var(--color-ink);">
                  ₹<%= doc.consultationFee %>
                </div>
              </div>
              <div style="text-align: right;">
                <span class="mono-label" style="font-size: 0.68rem;">Working Hours</span>
                <div style="font-size: 0.82rem; font-family: var(--font-mono); color: var(--color-soft-ink);">
                  <%= doc.workingHours?.start || '09:00' %> - <%= doc.workingHours?.end || '17:00' %>
                </div>
              </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
              <a href="/doctors/<%= doc._id %>" class="btn btn-outline btn-sm" style="font-size: 0.82rem; text-align: center;">
                ⭐ Profile & Reviews
              </a>
              <a href="/appointments/book/<%= doc._id %>" class="btn btn-accent btn-sm" style="font-size: 0.82rem; text-align: center;">
                📅 Book Appointment
              </a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <%- include('../partials/empty-state', { title: 'No Doctors Found', message: 'No healthcare providers match your current search or specialization filter.', actionUrl: '/doctors', actionLabel: 'View All Doctors' }) %>
  <% } %>
</div>
