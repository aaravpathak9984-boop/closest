<div style="max-width: 500px; margin: 3rem auto;" class="text-center">
  <div class="glass-card sketch-corner">
    <span class="mono-label" style="color: var(--color-red-accent);">Application Error</span>
    <h2 style="margin-top: 0.5rem;"><%= title || 'Error' %></h2>
    <p style="font-size: 0.88rem; color: var(--color-soft-ink); margin-bottom: 1.5rem;">
      <%= message || 'An error occurred while processing your request.' %>
    </p>

    <a href="/" class="btn btn-primary">&larr; Return to Home Page</a>
  </div>
</div>
