<div style="max-width: 500px; margin: 3rem auto;" class="text-center">
  <div class="glass-card sketch-corner">
    <span class="mono-label" style="color: var(--color-red-accent);">Error Code 404</span>
    <h1 style="font-size: 3.5rem; margin: 0.25rem 0 0.5rem; font-family: var(--font-serif);">404</h1>
    <h2>Page Not Found</h2>
    <p style="font-size: 0.88rem; color: var(--color-soft-ink); margin-bottom: 1.5rem;">
      The page <code><%= path || '' %></code> does not exist or has been moved.
    </p>

    <a href="/" class="btn btn-primary">&larr; Return to Home Page</a>
  </div>
</div>
