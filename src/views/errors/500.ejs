<div style="max-width: 600px; margin: 3rem auto;">
  <div class="glass-card sketch-corner">
    <span class="mono-label" style="color: var(--color-red-accent);">Error Code <%= statusCode || 500 %></span>
    <h1 style="font-size: 3.5rem; margin: 0.25rem 0 0.5rem; font-family: var(--font-serif);">500</h1>
    <h2>Internal Server Error</h2>
    <p style="font-size: 0.88rem; color: var(--color-soft-ink); margin-bottom: 1.5rem;">
      <%= message || 'An unexpected error occurred while processing your request.' %>
    </p>

    <% if (stack) { %>
      <div class="paper-card" style="text-align: left; background-color: var(--color-ink); color: #F8F8F8; padding: 1rem; overflow-x: auto; margin-bottom: 1.5rem;">
        <span class="mono-label" style="color: var(--color-red-accent);">Development Stack Trace</span>
        <pre style="font-family: var(--font-mono); font-size: 0.75rem; white-space: pre-wrap; margin-top: 0.5rem;"><%= stack %></pre>
      </div>
    <% } %>

    <div style="display: flex; gap: 0.75rem; justify-content: center;">
      <a href="/" class="btn btn-primary">&larr; Home</a>
      <button type="button" class="btn btn-outline" onclick="window.location.reload();">Retry</button>
    </div>
  </div>
</div>
